# PostgreSQL connection used by Prisma on the server only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verio?schema=public"

# Used to authenticate calls made by the managed scheduler.
INTERNAL_JOB_SECRET="replace-with-at-least-32-characters"

# Public URL of this deployment. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk authentication. Create development keys at https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace-me"
CLERK_SECRET_KEY="sk_test_replace-me"

# Authentication routes used by Clerk redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/entrar"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/cadastro"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/painel"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/painel"

# Optional integrations are added only when their adapters are implemented.
# AI_API_KEY=""
# BILLING_WEBHOOK_SECRET=""
