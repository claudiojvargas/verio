# PostgreSQL connection used by Prisma on the server only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verio?schema=public"

# Used to authenticate calls made by the managed scheduler.
INTERNAL_JOB_SECRET="replace-with-at-least-32-characters"

# Public URL of this deployment. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional integrations are added only when their adapters are implemented.
# AI_API_KEY=""
# AUTH_SECRET=""
# BILLING_WEBHOOK_SECRET=""
