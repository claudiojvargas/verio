    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.7",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.6",
    "prettier": "3.7.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.18",
